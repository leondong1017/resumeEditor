# Copy to `.env.local` and fill in values. Never commit `.env.local`.
#
# Default wiring in this repo (see lib/ai/provider.ts):
# - Parse + rewrite always use Moonshot (Kimi) OpenAI-compatible API (api.moonshot.cn).
# - Full-document review uses MiMo when MIMO_API_KEY is set; otherwise Kimi.
# Switching to OpenAI / Anthropic / another gateway requires changing provider code,
# not only these variables.

# Required for default AI features (Kimi)
MOONSHOT_API_KEY=

# Optional: Xiaomi MiMo for review path
# MIMO_API_KEY=
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_REVIEW_MODEL=mimo-v2-pro
# MIMO_STRUCTURED_OUTPUTS=false

# Optional: model ids when still using the Moonshot endpoint (not “any vendor” switches)
# AI_PARSE_MODEL=kimi-k2-turbo-preview
# AI_REWRITE_MODEL=kimi-k2.5
# AI_REVIEW_MODEL=kimi-k2.5
